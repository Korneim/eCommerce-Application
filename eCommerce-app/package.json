        "@babel/preset-typescript": "^7.27.1",
        "@commitlint/config-conventional": "^19.8.0",
        "@eslint/js": "^9.22.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.15.29",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
