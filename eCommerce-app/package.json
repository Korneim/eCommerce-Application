        "@types/testing-library__jest-dom": "^5.14.9",
        "@vitejs/plugin-react": "^4.5.0",
        "babel-jest": "^29.7.0",
        "commitlint": "^19.8.0",
        "eslint": "^9.25.1",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "eslint-plugin-unicorn": "^59.0.0",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "identity-obj-proxy": "^3.0.0",
