        "@testing-library/react": "^16.3.0",
        "antd": "^5.24.9",
        "dayjs": "^1.11.13",
        "jest-environment-jsdom": "^30.0.0-beta.3",
        "normalize.css": "^8.0.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.56.1",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.5.2",
        "sass": "^1.87.0",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.26.9",
